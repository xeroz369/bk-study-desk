root = false

[*.cs]
# Chuỗi hiển thị cho người dùng Việt, số/ngày tự định dạng rõ ràng: bỏ cảnh báo văn hóa định dạng.
dotnet_diagnostic.CA1305.severity = none
# Config.Int/Str/Bool là API đọc cấu hình có chủ ý.
