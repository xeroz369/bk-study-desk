<!-- Tải tài liệu của một khóa LMS theo từng section: chọn mục, chọn có tự giải nén zip không, xem tiến độ. -->
<Window x:Class="SoHocTap.Ui.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SoHocTap.Ui"
        Width="620" Height="600" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Sub" DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,10" TextWrapping="Wrap" />

        <!-- Nút cuối window: Tải (default) · Đóng (Esc) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="Start" Content="{ui:T download.start}" IsDefault="True" MinWidth="90" Style="{DynamicResource AccentButtonStyle}" Click="OnStart" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Content="{ui:T common.close}" IsCancel="True" MinWidth="90" Click="OnClose" />
            </StackPanel>
            <CheckBox x:Name="Extract" Content="{ui:T download.extract}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBox x:Name="Output" DockPanel.Dock="Bottom" Height="110" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />

        <!-- Loại file: slide thường nặng nhất, bỏ chọn để chỉ tải PDF. Số file và dung lượng bên dưới tính theo lựa chọn này. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{ui:T download.kinds}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox x:Name="KindPdf" Content="PDF" IsChecked="True" Checked="OnKinds" Unchecked="OnKinds" Margin="0,0,16,0" />
            <CheckBox x:Name="KindSlide" Content="{ui:T download.kindSlide}" IsChecked="True" Checked="OnKinds" Unchecked="OnKinds" Margin="0,0,16,0" />
            <CheckBox x:Name="KindOther" Content="{ui:T download.kindOther}" IsChecked="True" Checked="OnKinds" Unchecked="OnKinds" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{ui:T download.all}" Click="OnAll" Padding="10,3" Margin="0,0,6,0" />
                <Button Content="{ui:T download.none}" Click="OnNone" Padding="10,3" />
            </StackPanel>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="4">
            <ListBox x:Name="Sections" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="OnPick" Unchecked="OnPick" Margin="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
