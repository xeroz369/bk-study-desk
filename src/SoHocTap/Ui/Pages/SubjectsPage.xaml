<!-- Môn học: danh sách môn (trái) | chi tiết môn (phải).
     Chi tiết: tiêu đề + thông tin nhanh + lệnh (Tải tài liệu theo mục · Mở trên LMS · Mở thư mục) và các tab
     Tài liệu (duyệt folder kiểu File Explorer), Mới cập nhật, Sắp tới, Thông báo, Điểm trên LMS, Lớp trên LMS. -->
<UserControl x:Class="SoHocTap.Ui.Pages.SubjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui"
             xmlns:c="clr-namespace:SoHocTap.Ui.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Danh sách môn theo tỉ lệ (tối đa 300): cửa sổ hẹp thì nhường chỗ cho bảng tài liệu. Kéo thanh chia vẫn đổi được. -->
            <ColumnDefinition Width="0.3*" MinWidth="180" MaxWidth="300" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="4">
            <DockPanel>
                <!-- WPF không có placeholder cho TextBox: chữ gợi ý nằm đè lên, ẩn khi đã gõ. -->
                <Grid DockPanel.Dock="Top" Margin="4,4,4,6">
                    <TextBox x:Name="Filter" TextChanged="OnFilter" ToolTip="{ui:T subjects.filter.tip}" AutomationProperties.Name="{ui:T subjects.filter}"
                             AutomationProperties.HelpText="{ui:T subjects.filter.tip}" />
                    <TextBlock x:Name="FilterHint" Text="{ui:T subjects.filter}" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
                <ListBox x:Name="List" ItemContainerStyle="{StaticResource NavItem}" BorderThickness="0" Background="Transparent" SelectionChanged="OnPick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,8,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,2">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ToolTip="{ui:T subjects.splitter.tip}" />

        <DockPanel Grid.Column="2" Margin="8,0,0,0">
            <!-- Tên môn và nút cùng hàng; dòng thông tin nhanh chiếm cả bề ngang bên dưới để không bị nút che mất. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                    <Button x:Name="DownloadButton" Click="OnDownload" Margin="0,0,8,0" ToolTip="{ui:T subjects.download.tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{ui:T subjects.download}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LmsButton" Content="{ui:T subjects.openLms}" Click="OnOpenLms" Margin="0,0,8,0" />
                    <Button Content="{ui:T subjects.openFolder}" Click="OnReveal" ToolTip="{ui:T subjects.openFolder.tip}" />
                </StackPanel>
                <TextBlock x:Name="SubjectName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="SubjectMeta" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
            </Grid>
            <!-- Chỉ dựng tab đang chọn (OnTab): tab Tài liệu, Mới cập nhật đọc đĩa trên thread pool. -->
            <TabControl x:Name="Tabs" SelectionChanged="OnTab">
                <TabItem Header="{ui:T subjects.tabFiles}">
                    <DockPanel Margin="0,8,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="UpButton" Content="&#xE74A;" FontFamily="{StaticResource IconFont}" Click="OnUp" ToolTip="{ui:T subjects.up.tip}"
                                    AutomationProperties.Name="{ui:T subjects.up.tip}" />
                            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" FontSize="13" />
                        </DockPanel>
                        <c:DataView x:Name="Files" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="{ui:T subjects.tabRecent}">
                    <c:DataView x:Name="Recent" Margin="0,8,0,0" />
                </TabItem>
                <TabItem Header="{ui:T subjects.tabDue}">
                    <c:DataView x:Name="Due" Margin="0,8,0,0" />
                </TabItem>
                <TabItem Header="{ui:T subjects.tabNews}">
                    <c:DataView x:Name="News" Margin="0,8,0,0" />
                </TabItem>
                <TabItem Header="{ui:T subjects.tabGrades}">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Style="{StaticResource Muted}" Text="{ui:T subjects.gradesNote}" />
                        <c:DataView x:Name="Grades" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="{ui:T subjects.tabCourses}">
                    <c:DataView x:Name="Courses" Margin="0,8,0,0" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
