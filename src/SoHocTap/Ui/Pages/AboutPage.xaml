<!-- Giới thiệu: tên, version, tác giả, giấy phép, link chính thức (AppInfo). Không có mục ủng hộ trong app (giấy phép: không đưa dịch vụ thu tiền vào app); ủng hộ chỉ để trên GitHub. -->
<UserControl x:Class="SoHocTap.Ui.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <!-- ScrollViewer không nhận focus; lề phải để thanh cuộn nổi không đè lên card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,14,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="AboutName" FontSize="{DynamicResource AppFontSizeDisplay}" FontWeight="SemiBold" />
                    <TextBlock x:Name="AboutLine" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <TextBlock Text="{ui:T about.unofficial}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{ui:T about.source}" Click="OnSource" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,8" />
                        <Button Content="{ui:T about.issues}" Click="OnIssues" Margin="0,0,8,8" />
                        <Button Content="{ui:T about.privacy}" Click="OnPrivacy" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:T about.officialTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="Official" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
