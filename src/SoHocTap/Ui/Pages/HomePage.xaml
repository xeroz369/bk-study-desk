<!-- Hôm nay: số liệu chính, 7 ngày tới (bảng nhóm theo ngày), lịch thi, thông báo mới trên LMS. -->
<UserControl x:Class="SoHocTap.Ui.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui"
             xmlns:c="clr-namespace:SoHocTap.Ui.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ItemsControl x:Name="Stats" Margin="0,0,0,12" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12,8" ToolTip="{Binding Label}">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                            <!-- Màu số theo mức (sắp thi, có hạn nộp): DynamicResource để đổi theo sáng/tối của Windows ngay khi đang mở. -->
                            <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Bad">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Cột phải theo tỉ lệ (không cố định 320): cửa sổ hẹp thì bảng 7 ngày tới vẫn đủ chỗ cho tên việc. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="440" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="4,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{ui:T home.next7}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" />
                    <c:DataView x:Name="Agenda" />
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="4,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,0,0,4">
                            <Button x:Name="PlanButton" DockPanel.Dock="Right" Content="{ui:T home.plan}" Click="OnPlan" Padding="8,2" ToolTip="{ui:T home.plan.tip}" />
                            <TextBlock Text="{ui:T home.exams}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <c:DataView x:Name="Exams" />
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4,8" VerticalAlignment="Top">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{ui:T home.news}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" TextTrimming="CharacterEllipsis" />
                        <c:DataView x:Name="News" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
