<!-- Hôm nay: bên trái việc phải làm trong 7 ngày tới (bảng nhóm theo ngày); bên phải lịch học hôm nay và ngày mai, lịch thi,
     đăng ký môn, thông báo mới trên LMS. Không có ô số tóm tắt: các bảng đã đủ số, ô số chỉ lặp lại. -->
<UserControl x:Class="SoHocTap.Ui.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui"
             xmlns:c="clr-namespace:SoHocTap.Ui.Controls">
    <!-- Cột phải theo tỉ lệ (không cố định 320): cửa sổ hẹp thì bảng 7 ngày tới vẫn đủ chỗ cho tên việc. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="440" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="4,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{ui:T home.next7}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" />
                <Border x:Name="AgendaHost" />
            </DockPanel>
        </Border>
        <!-- Bốn thẻ chồng nhau: cửa sổ thấp thì cả cột cuộn, không cắt thẻ nào (DESIGN 6b-3). -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- Lịch học hôm nay và ngày mai (buổi học từ MyBK): giờ, phòng. Bảng bên trái chỉ còn việc phải làm. -->
                <Border Style="{StaticResource Card}" Padding="4,8" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{ui:T home.classes}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" TextTrimming="CharacterEllipsis" />
                        <c:DataView x:Name="Classes" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="4,8" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{ui:T home.exams}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" TextTrimming="CharacterEllipsis" />
                        <c:DataView x:Name="Exams" />
                    </DockPanel>
                </Border>
                <!-- Đăng ký môn MyBK: đợt đang mở rồi đợt sắp mở gần nhất (Data/Registrations.cs); bấm đúp mở trang đăng ký trong app. -->
                <Border Style="{StaticResource Card}" Padding="4,8" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{ui:T home.reg}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" TextTrimming="CharacterEllipsis" />
                        <c:DataView x:Name="Regs" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="4,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{ui:T home.news}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" TextTrimming="CharacterEllipsis" />
                        <c:DataView x:Name="News" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
