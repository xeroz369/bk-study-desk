<!-- Hôm nay: số liệu chính · 7 ngày tới (bảng nhóm theo ngày) · lịch thi · thông báo mới trên LMS. -->
<UserControl x:Class="SoHocTap.Ui.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ItemsControl x:Name="Stats" Margin="0,0,0,12" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="4,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{ui:T home.next7}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" />
                    <TextBlock x:Name="AgendaEmpty" DockPanel.Dock="Top" Margin="8,0" Style="{StaticResource Muted}" Text="{ui:T home.agendaEmpty}" Visibility="Collapsed" />
                    <DataGrid x:Name="Agenda" />
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="4,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,0,0,4">
                            <Button x:Name="PlanButton" DockPanel.Dock="Right" Content="{ui:T home.plan}" Click="OnPlan" Padding="8,2" ToolTip="{ui:T home.plan.tip}" />
                            <TextBlock Text="{ui:T home.exams}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <TextBlock x:Name="ExamsEmpty" DockPanel.Dock="Top" Margin="8,0" Style="{StaticResource Muted}" Text="{ui:T home.examsEmpty}" Visibility="Collapsed" />
                        <DataGrid x:Name="Exams" HeadersVisibility="None" />
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4,8" VerticalAlignment="Top">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{ui:T home.news}" Style="{StaticResource SectionTitle}" Margin="8,0,0,4" />
                        <TextBlock x:Name="NewsEmpty" DockPanel.Dock="Top" Margin="8,0" Style="{StaticResource Muted}" Text="{ui:T home.newsEmpty}" />
                        <DataGrid x:Name="News" HeadersVisibility="None" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
