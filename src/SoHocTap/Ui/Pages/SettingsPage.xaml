<!-- Cài đặt: xếp các thẻ theo Ui/Settings/SettingsSections.cs, thẻ hay dùng trước, mục Nâng cao gập sẵn ở dưới. Mỗi thẻ tự lưu ngay khi đổi vào data/config.json. -->
<UserControl x:Class="SoHocTap.Ui.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <!-- ScrollViewer không nhận focus (Tab đi thẳng vào ô đầu tiên); lề phải để thanh cuộn nổi của Fluent không đè lên card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,14,0">
            <StackPanel x:Name="Cards" />
            <Expander x:Name="AdvancedBox" Header="{ui:T settings.advanced}" Expanded="OnAdvanced" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="AdvancedCards" Margin="0,12,0,0" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
