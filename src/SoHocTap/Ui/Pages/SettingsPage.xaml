<!-- Cài đặt: tài khoản HCMUT, mở tài liệu, sync và nhắc hạn, xếp file Tải xuống, shortcut. Lưu vào data/config.json. -->
<UserControl x:Class="SoHocTap.Ui.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <!-- ScrollViewer không nhận focus (Tab đi thẳng vào ô đầu tiên); lề phải để thanh cuộn nổi của Fluent không đè lên card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,14,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="LoginButton" Click="OnLogin" Margin="0,0,8,0" />
                        <Button x:Name="LogoutButton" Content="{ui:T settings.logout}" Click="OnLogout" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{ui:T settings.account}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AccountText" />
                        <TextBlock x:Name="AccountDetail" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{ui:T settings.accountNote}" />
                        <CheckBox x:Name="Remember" Margin="0,10,0,0" Click="OnRemember" Style="{StaticResource WrapCheck}" />
                        <CheckBox x:Name="KeepAlive" Margin="0,6,0,0" Content="{ui:T settings.keepAlive}" Click="OnKeepAlive" Style="{StaticResource WrapCheck}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,2,0,0" Text="{ui:T settings.keepAlive.note}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Ngôn ngữ: các file trong lang\ cạnh exe; đổi xong phải restart app. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.language}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <ComboBox x:Name="LanguageBox" MinWidth="200" DisplayMemberPath="Name" SelectionChanged="OnLanguage"
                                  AutomationProperties.Name="{ui:T settings.language}" />
                        <TextBlock x:Name="LanguageNote" Text="{ui:T settings.languageNote}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Visibility="Collapsed" />
                        <Button x:Name="RestartButton" Content="{ui:T settings.restart}" Margin="12,0,0,0" Click="OnRestart"
                                Style="{DynamicResource AccentButtonStyle}" Visibility="Collapsed" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Chữ: phông và cỡ chữ của cả app (app.font.family, app.font.size), đổi là thấy ngay (Ui/AppFont.cs). Dòng mẫu có dấu tiếng Việt
                 vẽ bằng phông đang chọn để thấy phông có đủ dấu không. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.font}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8">
                            <Label Content="{ui:T settings.font.family}" Target="{Binding ElementName=FontFamilyBox}" Padding="0,0,0,4" />
                            <ComboBox x:Name="FontFamilyBox" MinWidth="260" MaxDropDownHeight="360" SelectionChanged="OnFontFamily" IsTextSearchEnabled="True"
                                      AutomationProperties.Name="{ui:T settings.font.family}">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <Label Content="{ui:T settings.font.size}" Target="{Binding ElementName=FontSizeBox}" Padding="0,0,0,4" />
                            <ComboBox x:Name="FontSizeBox" MinWidth="200" SelectionChanged="OnFontSize" AutomationProperties.Name="{ui:T settings.font.size}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{ui:T settings.font.preview}" Style="{StaticResource Muted}" Margin="0,4,0,2" />
                    <TextBlock x:Name="FontPreview" Text="{ui:T settings.font.sample}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{ui:T settings.font.note}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{ui:T settings.font.reset}" Click="OnFontReset" />
                        <TextBlock x:Name="FontStatus" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Cập nhật (chỉ bản public): người dùng chọn có kiểm tra bản mới không; nút kiểm tra luôn dùng được. -->
            <Border x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{ui:T update.settings}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <ComboBox x:Name="UpdateModeBox" MinWidth="320" SelectionChanged="OnUpdateMode" AutomationProperties.Name="{ui:T update.settings}" />
                        <Button x:Name="UpdateCheck" Content="{ui:T update.check}" Margin="12,0,0,0" Click="OnUpdateCheck" />
                    </WrapPanel>
                    <!-- Kiểm tra bao lâu một lần (app.update.checkHours): 6, 12, 24 giờ. Máy thức dậy, có mạng lại thì kiểm tra thêm nếu đã tới hạn. -->
                    <WrapPanel x:Name="UpdateIntervalRow" Margin="0,8,0,0">
                        <TextBlock Text="{ui:T update.interval}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="UpdateIntervalBox" MinWidth="160" SelectionChanged="OnUpdateInterval" AutomationProperties.Name="{ui:T update.interval}" />
                    </WrapPanel>
                    <TextBlock x:Name="UpdateNote" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <!-- Đang tải bản mới (từ cửa sổ cập nhật hay chế độ Tự động): thanh có số thật (DownloadView) và nút Hủy tải. -->
                    <StackPanel x:Name="UpdateProgressRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="UpdateBar" Width="320" Minimum="0" Maximum="100" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="UpdateCancel" Content="{ui:T update.cancel}" Margin="12,0,0,0" Click="OnUpdateCancel" />
                    </StackPanel>
                    <!-- Bản cài: chép dữ liệu từ bản zip đang dùng trước đây (đăng nhập LMS, kết quả, quiz, cài đặt). -->
                    <Button x:Name="ImportZip" Content="{ui:T update.import}" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Visibility="Collapsed" Click="OnImportZip" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.openDocs}" Style="{StaticResource SectionTitle}" />
                    <Label Content="{ui:T settings.pdfApp}" Target="{Binding ElementName=PdfApp}" Padding="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{ui:T settings.browse}" Margin="8,0,0,0" Click="OnBrowsePdf" />
                        <TextBox x:Name="PdfApp" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{ui:T settings.pdfNote}" />
                    <Label Content="{ui:T settings.root}" Target="{Binding ElementName=Root}" Padding="0,12,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{ui:T settings.browse}" Margin="8,0,0,0" Click="OnBrowseRoot" />
                        <TextBox x:Name="Root" />
                    </DockPanel>
                    <TextBlock x:Name="RootNote" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.startup}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutoStart" Content="{ui:T settings.autoStart}" Click="OnAutoStart" Style="{StaticResource WrapCheck}" />
                    <TextBlock Text="{ui:T settings.closeButton}" Margin="0,12,0,4" />
                    <RadioButton x:Name="CloseToTray" GroupName="Close" Content="{ui:T settings.closeToTray}" Click="OnCloseMode" />
                    <RadioButton x:Name="CloseExit" GroupName="Close" Content="{ui:T settings.closeExit}" Click="OnCloseMode" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.sync}" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="260" />
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="{ui:T settings.lmsHours}" Target="{Binding ElementName=LmsHours}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="LmsHours" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.lmsHoursNote}" />
                        <Label Grid.Row="1" Content="{ui:T settings.mybkHours}" Target="{Binding ElementName=MybkHours}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MybkHours" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.mybkHoursNote}" />
                        <Label Grid.Row="2" Content="{ui:T settings.notifyHours}" Target="{Binding ElementName=NotifyHours}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="NotifyHours" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.notifyHoursNote}" />
                        <Label Grid.Row="3" Content="{ui:T settings.lastHours}" Target="{Binding ElementName=LastHours}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="LastHours" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.lastHoursNote}" />
                        <Label Grid.Row="4" Content="{ui:T settings.maxMb}" Target="{Binding ElementName=MaxMb}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="MaxMb" Margin="0,3" />
                    </Grid>
                    <CheckBox x:Name="AutoDownload" Margin="0,10,0,0" Content="{ui:T settings.autoDownload}" Style="{StaticResource WrapCheck}" />
                    <CheckBox x:Name="AutoExtract" Margin="0,6,0,0" Content="{ui:T settings.autoExtract}" Style="{StaticResource WrapCheck}" />
                    <CheckBox x:Name="SaveQuizzes" Margin="0,6,0,0" Content="{ui:T settings.saveQuizzes}" ToolTip="{ui:T settings.saveQuizzes.tip}" Click="OnSaveQuizzes"
                              Style="{StaticResource WrapCheck}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{ui:T settings.save}" Click="OnSave" IsDefault="False" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="{ui:T settings.resync}" Margin="8,0,0,0" Click="OnResync" ToolTip="{ui:T settings.resync.tip}" />
                        <TextBlock x:Name="SaveText" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Muted}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.organize}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Content="{ui:T settings.preview}" Click="OnPlan" />
                        <Button x:Name="ApplyButton" Content="{ui:T settings.apply}" Margin="8,0,0,0" Click="OnApply" IsEnabled="False" />
                    </WrapPanel>
                    <TextBox x:Name="PlanText" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Thư viện tài liệu chung (library.*): bật mặc định, tắt được. Địa chỉ chỉ sửa được khi bật log chẩn đoán (dev). -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.library}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="LibraryEnabled" Content="{ui:T settings.library.enable}" Click="OnLibraryEnabled" Style="{StaticResource WrapCheck}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,2,0,0" Text="{ui:T settings.library.note}" />
                    <Label Content="{ui:T settings.library.baseUrl}" Target="{Binding ElementName=LibraryUrl}" Padding="0,12,0,4" />
                    <TextBox x:Name="LibraryUrl" IsReadOnly="True" LostFocus="OnLibraryUrl" KeyDown="OnLibraryUrlKey" />
                    <TextBlock x:Name="LibraryStatus" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{ui:T settings.library.open}" Margin="0,0,8,0" Click="OnLibraryOpen" />
                        <Button Content="{ui:T settings.library.clear}" Click="OnLibraryClear" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Nhật ký lỗi: log chi tiết chỉ bật khi cần báo lỗi (app.debugLog); không ghi mật khẩu, token, cookie. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.debug}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="DebugLog" Content="{ui:T settings.debugLog}" Click="OnDebugLog" Style="{StaticResource WrapCheck}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,2,0,0" Text="{ui:T settings.debugNote}" />
                    <Button Content="{ui:T settings.openLog}" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnOpenLog" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{ui:T settings.keys}" Style="{StaticResource SectionTitle}" />
                    <DataGrid x:Name="Keys" HeadersVisibility="None" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
