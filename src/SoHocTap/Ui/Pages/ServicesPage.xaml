<!-- Dịch vụ: mở thẳng các trang của trường (MyBK, LMS, BKPay, đăng ký…) trong window của app, dùng chung session HCMUT.
     Danh sách nằm trong data/config.json (sources.mybk.services). -->
<UserControl x:Class="SoHocTap.Ui.Pages.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="13"
                       Text="{ui:T services.hint}" />
            <Label Content="{ui:T services.filter}" Target="{Binding ElementName=Search}" VerticalAlignment="Center" Padding="0,0,10,0" />
            <TextBox x:Name="Search" Width="280" HorizontalAlignment="Left" TextChanged="OnSearch" ToolTip="{ui:T services.search.tip}" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="4,8">
            <DataGrid x:Name="List" />
        </Border>
    </DockPanel>
</UserControl>
