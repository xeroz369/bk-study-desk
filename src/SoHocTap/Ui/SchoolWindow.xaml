<!-- Window web của trường nằm trong app (LMS, MyBK, dịch vụ): dùng chung session đăng nhập, tải file được.
     Thanh báo phía trên (InfoBar giống window chính) cho biết trang đang tải chậm, mất mạng, server lỗi hay phiên đăng nhập đã hết,
     để người dùng không phải nhìn trang trắng mà không biết vì sao. -->
<Window x:Class="SoHocTap.Ui.SchoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SoHocTap.Ui"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1200" Height="820" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ui:SeverityBar x:Name="Bar" DockPanel.Dock="Top" CornerRadius="0" BorderThickness="0,0,0,1" />
        <ProgressBar x:Name="Loading" DockPanel.Dock="Top" Height="2" IsIndeterminate="True" Visibility="Collapsed" />
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
