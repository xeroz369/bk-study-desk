<!-- Chữ: phông và cỡ chữ của cả app (app.font.family, app.font.size), đổi là thấy ngay (Ui/AppFont.cs). Dòng mẫu có dấu tiếng Việt
     vẽ bằng phông đang chọn để thấy phông có đủ dấu không. -->
<UserControl x:Class="SoHocTap.Ui.SettingsCards.FontSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{ui:T settings.font}" Style="{StaticResource SectionTitle}" />
            <WrapPanel>
                <StackPanel Margin="0,0,16,8">
                    <Label Content="{ui:T settings.font.family}" Target="{Binding ElementName=FontFamilyBox}" Padding="0,0,0,4" />
                    <ComboBox x:Name="FontFamilyBox" MinWidth="260" MaxDropDownHeight="360" SelectionChanged="OnFontFamily" IsTextSearchEnabled="True"
                              AutomationProperties.Name="{ui:T settings.font.family}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <Label Content="{ui:T settings.font.size}" Target="{Binding ElementName=FontSizeBox}" Padding="0,0,0,4" />
                    <ComboBox x:Name="FontSizeBox" MinWidth="200" SelectionChanged="OnFontSize" AutomationProperties.Name="{ui:T settings.font.size}" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="{ui:T settings.font.preview}" Style="{StaticResource Muted}" Margin="0,4,0,2" />
            <TextBlock x:Name="FontPreview" Text="{ui:T settings.font.sample}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{ui:T settings.font.note}" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="{ui:T settings.font.reset}" Click="OnFontReset" />
                <TextBlock x:Name="FontStatus" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
