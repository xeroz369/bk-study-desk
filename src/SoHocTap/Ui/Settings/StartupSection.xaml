<!-- Khi mở và đóng app: chạy cùng Windows, nút X thu xuống khay hay thoát (app.closeToTray). -->
<UserControl x:Class="SoHocTap.Ui.SettingsCards.StartupSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{ui:T settings.startup}" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="AutoStart" Content="{ui:T settings.autoStart}" Click="OnAutoStart" Style="{StaticResource WrapCheck}" />
            <TextBlock Text="{ui:T settings.closeButton}" Margin="0,12,0,4" />
            <RadioButton x:Name="CloseToTray" GroupName="Close" Content="{ui:T settings.closeToTray}" Click="OnCloseMode" />
            <RadioButton x:Name="CloseExit" GroupName="Close" Content="{ui:T settings.closeExit}" Click="OnCloseMode" Margin="0,4,0,0" />
            <TextBlock x:Name="Error" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
