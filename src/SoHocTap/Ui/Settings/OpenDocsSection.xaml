<!-- Mở tài liệu: app PDF riêng (viewer.pdfApp) và thư mục lưu tài liệu (folders.root). Lưu khi rời ô, bấm Enter hoặc chọn bằng Duyệt. -->
<UserControl x:Class="SoHocTap.Ui.SettingsCards.OpenDocsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{ui:T settings.openDocs}" Style="{StaticResource SectionTitle}" />
            <Label Content="{ui:T settings.pdfApp}" Target="{Binding ElementName=PdfApp}" Padding="0,0,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{ui:T settings.browse}" Margin="8,0,0,0" Click="OnBrowsePdf" />
                <TextBox x:Name="PdfApp" LostFocus="OnPdfCommit" LostKeyboardFocus="OnPdfLeave" KeyDown="OnPdfKey" />
            </DockPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{ui:T settings.pdfNote}" />
            <Label Content="{ui:T settings.root}" Target="{Binding ElementName=Root}" Padding="0,12,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{ui:T settings.browse}" Margin="8,0,0,0" Click="OnBrowseRoot" />
                <TextBox x:Name="Root" LostFocus="OnRootCommit" LostKeyboardFocus="OnRootLeave" KeyDown="OnRootKey" />
            </DockPanel>
            <TextBlock x:Name="RootNote" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="Error" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
