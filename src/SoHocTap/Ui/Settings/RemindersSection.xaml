<!-- Nhắc hạn: hai lần nhắc của Windows (notify.hoursBefore, notify.lastHours), hai mốc màu gấp (notify.urgentHours, notify.soonHours), giờ gom nhắc (notify.digestTimes).
     0 = tắt mốc đó. Ô số lưu khi rời ô hoặc Enter. -->
<UserControl x:Class="SoHocTap.Ui.SettingsCards.RemindersSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{ui:T settings.reminders}" Style="{StaticResource SectionTitle}" />
            <!-- Cùng bố cục với thẻ Đồng bộ: nhãn, ô số, ghi chú; hàng lỗi ngay dưới mỗi ô. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="260" />
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
                    <RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="{ui:T settings.notifyHours}" Target="{Binding ElementName=NotifyHours}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NotifyHours" Margin="0,3" />
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.notifyHoursNote}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NotifyHoursError" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
                <Label Grid.Row="2" Content="{ui:T settings.lastHours}" Target="{Binding ElementName=LastHours}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="LastHours" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.lastHoursNote}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LastHoursError" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
                <Label Grid.Row="4" Content="{ui:T settings.urgentHours}" Target="{Binding ElementName=UrgentHours}" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="UrgentHours" Margin="0,3" />
                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.urgentHoursNote}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UrgentHoursError" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
                <Label Grid.Row="6" Content="{ui:T settings.soonHours}" Target="{Binding ElementName=SoonHours}" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="SoonHours" Margin="0,3" />
                <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="{ui:T settings.soonHoursNote}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SoonHoursError" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
            </Grid>
            <!-- Giờ gom nhắc (notify.digestTimes): bài còn xa hạn chờ tới các giờ này; ô chữ rộng hơn ô số nên đứng riêng một hàng. -->
            <Label Content="{ui:T settings.digestTimes}" Target="{Binding ElementName=DigestTimes}" Padding="0,10,0,4" />
            <TextBox x:Name="DigestTimes" MaxWidth="320" HorizontalAlignment="Left" MinWidth="200" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{ui:T settings.digestTimesNote}" />
            <TextBlock x:Name="DigestTimesError" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
            <!-- Mốc Rất gấp không nhỏ hơn mốc Gấp: vẫn lưu, chỉ nhắc rằng màu vàng sẽ không hiện (Due.SoonHidden). -->
            <TextBlock x:Name="SoonHint" Text="{ui:T settings.soonHidden}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
