<!-- Thư viện tài liệu chung (library.*): luôn bật, tab Thư viện luôn có. Địa chỉ chỉ sửa được khi bật log chẩn đoán (dev). -->
<UserControl x:Class="SoHocTap.Ui.SettingsCards.LibrarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{ui:T settings.library}" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{ui:T settings.library.note}" />
            <Label Content="{ui:T settings.library.baseUrl}" Target="{Binding ElementName=LibraryUrl}" Padding="0,12,0,4" />
            <TextBox x:Name="LibraryUrl" IsReadOnly="True" LostFocus="OnLibraryUrl" LostKeyboardFocus="OnLibraryUrlLeave" KeyDown="OnLibraryUrlKey" GotKeyboardFocus="OnLibraryUrlFocus" />
            <TextBlock x:Name="LibraryStatus" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="{ui:T settings.library.open}" Margin="0,0,8,0" Click="OnLibraryOpen" />
                <Button Content="{ui:T settings.library.clear}" Click="OnLibraryClear" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
