<!-- Phím tắt: bảng chỉ đọc, không có cấu hình. -->
<UserControl x:Class="SoHocTap.Ui.SettingsCards.KeysSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoHocTap.Ui">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{ui:T settings.keys}" Style="{StaticResource SectionTitle}" />
            <DataGrid x:Name="Keys" HeadersVisibility="None" />
        </StackPanel>
    </Border>
</UserControl>
