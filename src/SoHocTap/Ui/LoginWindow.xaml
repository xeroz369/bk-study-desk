<!-- Window login HCMUT: hiện trang SSO của trường cho người dùng tự nhập. Login xong MyBK và LMS thì tự đóng. -->
<Window x:Class="SoHocTap.Ui.LoginWindow"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SoHocTap.Ui"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{ui:T login.title}" Width="900" Height="720" WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="12,8" TextWrapping="Wrap" Style="{StaticResource Muted}"
                   Text="{ui:T login.note}" />
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
