<!-- Bật tự đăng nhập lại: người dùng tự nhập tài khoản HCMUT vào app (không đọc từ trang đăng nhập). Enter lưu, Esc hủy. -->
<Window x:Class="SoHocTap.Ui.AutoLoginWindow"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SoHocTap.Ui"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" Text="{ui:T autoLogin.title}" Style="{StaticResource HeadingText}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap" Text="{ui:T autoLogin.note}" />
        <Label Content="{ui:T autoLogin.user}" Target="{Binding ElementName=UserBox}" Padding="0,0,0,4" />
        <TextBox x:Name="UserBox" />
        <Label Content="{ui:T autoLogin.password}" Target="{Binding ElementName=PasswordBox}" Padding="0,10,0,4" />
        <PasswordBox x:Name="PasswordBox" />
        <TextBlock x:Name="Error" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{ui:T autoLogin.save}" IsDefault="True" MinWidth="90" Style="{DynamicResource AccentButtonStyle}" Click="OnSave" Margin="0,0,8,0" />
            <Button Content="{ui:T events.cancel}" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
