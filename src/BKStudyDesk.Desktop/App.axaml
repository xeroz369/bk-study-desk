<!-- Theme Fluent có sẵn của Avalonia; màu nhấn theo cài đặt app.accent (App.ApplyAccent đặt lúc mở và khi đổi, giá trị dưới đây chỉ là
     màu lúc dựng); mặc định chế độ tối (Cài đặt đổi được); DataGrid chính thức; token BK. -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BKStudyDesk.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#0388B4" RegionColor="#F4F6F8" />
                <ColorPaletteResources x:Key="Dark" Accent="#3AA6D0" RegionColor="#14181D" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://BKStudyDesk/Styles/Tokens.axaml" />
    </Application.Styles>
</Application>
