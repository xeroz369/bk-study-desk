    <!-- Nút chỉ có icon: nền trong, bo nhẹ, đổi nền khi rê chuột như nút Fluent; icon 18. -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /></Style>
    <!-- Trên thanh trên cùng: icon trắng, không nền khi rê (như mục trang). -->
    <Style Selector="Button.bar PathIcon"><Setter Property="Foreground" Value="White" /><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /></Style>
</Styles>
