<Project Sdk="Microsoft.NET.Sdk">

  <!-- BK Study Desk (Windows, macOS, Linux) bằng Avalonia 12, theme Fluent có sẵn. Sửa ở đâu: README.md cạnh file này;
       spec docs/plans/2026-10-06-ban-2-da-nen-tang.md; thiết kế design-system/bk/README.md. Lõi (dữ liệu, đồng bộ, logic trang): src/BKStudyDesk.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0: macOS, Linux (và chạy được trên Windows). net10.0-windows10.0.19041.0: bản Windows, thêm thông báo hệ thống (WinRT). -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Restore trên macOS, Linux cũng phải tải gói của target Windows (dù chỉ build -f net10.0); thiếu dòng này thì báo NETSDK1100. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BKStudyDesk.Desktop</RootNamespace>
    <AssemblyName>BKStudyDesk</AssemblyName>
    <Product>BK Study Desk</Product>
    <Version Condition="'$(Version)' == ''">1.2.5</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Khai báo Windows 10/11: thiếu thì NativeWebView không tạo được cửa sổ con (thử 06/10/2026). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Cắt (trim) bản publish theo RID cho nhẹ: TrimMode=partial chỉ cắt assembly đã đánh dấu trimmable (thư viện .NET, Avalonia mới), còn lại giữ nguyên.
       JSON dùng source generation (CoreJson, DesktopJson), binding biên dịch sẵn, nên không cần reflection. Build thường và test không có RID nên không bị ảnh hưởng. -->
  <!-- Chỉ bản Windows (win-*) self-contained: đã chạy thử sau khi cắt; Linux, macOS chưa thử. Publish không self-contained (job binskim) thì .NET không cho cắt (NETSDK1102). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) and '$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <!-- Bộ cài AppImage và cập nhật (Velopack), cùng phiên bản với app WPF. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- ICU đi kèm app chỉ ở bản Linux build theo RID (linux-*): ngày tháng tiếng Việt đúng mà không cần cài libicu.
       Windows 10 1903 trở lên có sẵn icu.dll (app cần 19041), bỏ gói ở đây nhẹ đi khoảng 30 MB (đo 19/10/2026).
       Bản chạy chung net10.0 (dotnet run trên macOS) dùng ICU của hệ thống: bật AppLocalIcu mà thiếu dylib thì .NET dừng app ngay lúc mở (CI macOS 08/10). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test khói giao diện (tests/BKStudyDesk.Ui.Tests) dựng cả view internal. -->
    <InternalsVisibleTo Include="BKStudyDesk.Ui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BKStudyDesk.Core\BKStudyDesk.Core.csproj" />
    <!-- Bộ dựng công thức cho Luyện tập (vendored, tự bảo trì). -->
    <ProjectReference Include="..\ThirdParty\XamlMath\AvaloniaMath\AvaloniaMath.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Phần chỉ có trên Windows (WinRT): chỉ biên dịch cho bản Windows; code gọi qua #if WINDOWS. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'windows'">
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>

  <!-- Luyện tập vẽ bằng control Avalonia (Views/Practice), không chép khung Svelte (ui/) hay manifest trống (PublicContent/) của 1.x.
       Không có content/ cạnh exe thì gói tự soạn, gói nhập ghi vào data/packs (Paths.Packs), không vào thư mục cài. -->

  <!-- Không đưa file debug vào bản publish: DebugType=none chỉ bỏ pdb của app, còn pdb có sẵn trong gói NuGet
       (libSkiaSharp.pdb 80 MB, libHarfBuzzSharp.pdb 20 MB) và Microsoft.DiaSymReader.Native vẫn bị chép. Đo 19/10/2026: nén nhẹ đi khoảng 25 MB. -->
  <Target Name="BoFileDebugKhiPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native'))" />
    </ItemGroup>
  </Target>

</Project>
