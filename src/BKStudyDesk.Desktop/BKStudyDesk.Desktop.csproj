<Project Sdk="Microsoft.NET.Sdk">

  <!-- BK Study Desk (Windows, macOS, Linux) bằng Avalonia 12, theme Fluent có sẵn. Sửa ở đâu: README.md cạnh file này;
       spec docs/plans/2026-10-06-ban-2-da-nen-tang.md; thiết kế design-system/bk/README.md. Lõi (dữ liệu, đồng bộ, logic trang): src/BKStudyDesk.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0: macOS, Linux (và chạy được trên Windows). net10.0-windows10.0.19041.0: bản Windows, thêm thông báo hệ thống (WinRT). -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Restore trên macOS, Linux cũng phải tải gói của target Windows (dù chỉ build -f net10.0); thiếu dòng này thì báo NETSDK1100. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BKStudyDesk.Desktop</RootNamespace>
    <AssemblyName>BKStudyDesk</AssemblyName>
    <Product>BK Study Desk</Product>
    <Version Condition="'$(Version)' == ''">1.2.3</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Khai báo Windows 10/11: thiếu thì NativeWebView không tạo được cửa sổ con (thử 06/10/2026). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <!-- ICU đi kèm app (Windows, Linux): ngày tháng tiếng Việt đúng mà không cần cài libicu. Gói này không có bản macOS. -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <!-- Bộ cài AppImage và cập nhật (Velopack), cùng phiên bản với app WPF. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Dùng ICU đi kèm chỉ ở bản Windows và bản Linux build theo RID (linux-*). Bản chạy chung net10.0 (dotnet run trên macOS)
       dùng ICU của hệ thống: macOS có sẵn, còn bật AppLocalIcu mà thiếu dylib thì .NET dừng app ngay lúc mở (thấy trên CI macOS 08/10). -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows' or $(RuntimeIdentifier.StartsWith('linux'))">
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BKStudyDesk.Core\BKStudyDesk.Core.csproj" />
    <!-- Bộ dựng công thức cho Luyện tập (vendored, tự bảo trì). -->
    <ProjectReference Include="..\ThirdParty\XamlMath\AvaloniaMath\AvaloniaMath.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Phần chỉ có trên Windows (WinRT): chỉ biên dịch cho bản Windows; code gọi qua #if WINDOWS. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'windows'">
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>

  <!-- Luyện tập vẽ bằng control Avalonia (Views/Practice), không chép khung Svelte (ui/) hay manifest trống (PublicContent/) của 1.x.
       Không có content/ cạnh exe thì gói tự soạn, gói nhập ghi vào data/packs (Paths.Packs), không vào thư mục cài. -->

</Project>
