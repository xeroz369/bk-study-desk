<!-- Khung (design-system/bk mục 4): thanh cao tối thiểu 48 nền Bar; vùng nội dung lề 24; trang chữ rộng tối đa ContentMaxWidth và cuộn cả vùng, trang bảng (IFillPage) lấp đầy và tự cuộn. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BKStudyDesk.Desktop.Lang"
        x:Class="BKStudyDesk.Desktop.MainWindow"
        Title="BK Study Desk" Width="1280" Height="820" MinWidth="480" MinHeight="480"
        Background="{DynamicResource PageBg}" Icon="avares://BKStudyDesk/Assets/app.ico">
    <DockPanel>
        <!-- Thanh trên cùng (design-system/bk mục 4): mục trang bên trái; phải là nút Thông báo (trạng thái đồng bộ ngắn, bấm ra bảng
             từng nguồn và các thông báo, đăng nhập lại), Cài đặt (có mục Tài khoản). Hẹp thì Cài đặt và các mục trang cuối gom vào nút
             Thêm (MainWindow.FitBar). -->
        <Border x:Name="Bar" DockPanel.Dock="Top" Background="{DynamicResource Bar}" MinHeight="{StaticResource BarHeight}">
            <DockPanel Margin="16,0">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Classes="bar" Margin="20,0,0,0"><TextBlock Text="{l:T nav.settings}" VerticalAlignment="Center" /></Button>
                <Button x:Name="More" DockPanel.Dock="Right" Classes="bar" IsVisible="False" Margin="20,0,0,0">
                    <TextBlock Text="{l:T nav.more}" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem x:Name="MoreSettings" Header="{l:T nav.settings}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- Nút Thông báo: bảng dựng lại mỗi lần mở (MainWindow.FillStatus). -->
                <Button x:Name="StatusButton" DockPanel.Dock="Right" Classes="bar" Margin="20,0,0,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
                </Button>
                <StackPanel x:Name="Nav" Orientation="Horizontal" Spacing="24" />
            </DockPanel>
        </Border>
        <!-- Dải báo (Presentation/InfoBar quyết định hiện gì): đăng nhập, hết phiên, lỗi đồng bộ, mời tự đăng nhập lại. Viền trái theo
             mức độ (Border.info.error...), chữ trái, nút phải, Đóng cuối. Ẩn khi không có gì để báo. -->
        <Border x:Name="Info" DockPanel.Dock="Top" Classes="info" IsVisible="False">
            <DockPanel>
                <Button x:Name="InfoClose" DockPanel.Dock="Right" Content="{l:T common.close}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="InfoPrimary" Classes="accent" />
                    <Button x:Name="InfoSecondary" />
                </StackPanel>
                <TextBlock x:Name="InfoText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <!-- Trang đăng nhập (Views/LoginView) phủ lên vùng nội dung khi cần mật khẩu, không mở cửa sổ riêng. -->
        <Panel>
            <ScrollViewer x:Name="Scroller">
                <Border x:Name="Page" Margin="24,24,24,32" />
            </ScrollViewer>
            <Border x:Name="LoginHost" Background="{DynamicResource PageBg}" IsVisible="False" />
        </Panel>
    </DockPanel>
</Window>
