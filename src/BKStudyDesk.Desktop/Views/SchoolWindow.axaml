<!-- Trang của trường trong cửa sổ app (bản 1.x: Ui/SchoolWindow): dùng chung phiên đăng nhập của app. Một dòng trạng thái (đang tải chậm,
     lỗi tải) có nút Thử lại; nút Mở trên trình duyệt. Chữ: lang/*.json. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BKStudyDesk.Desktop.Lang"
        x:Class="BKStudyDesk.Desktop.Views.SchoolWindow"
        Width="1100" Height="760" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}" Icon="avares://BKStudyDesk/Assets/app.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                MinHeight="{StaticResource CardHeaderHeight}" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="Retry" Content="{l:T web.retry}" IsVisible="False" Click="OnRetry" />
                    <Button Content="{l:T common.openWeb}" Click="OnBrowser" />
                </StackPanel>
                <TextBlock x:Name="Status" Classes="meta" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border x:Name="Host" />
    </DockPanel>
</Window>
