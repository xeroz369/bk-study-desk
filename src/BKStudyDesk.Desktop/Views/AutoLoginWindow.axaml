<!-- Bật tự đăng nhập lại: người dùng tự gõ tài khoản HCMUT; app lưu vào kho mật khẩu của hệ điều hành (Platform/Credentials.cs). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BKStudyDesk.Desktop.Lang"
        x:Class="BKStudyDesk.Desktop.Views.AutoLoginWindow"
        Title="{l:T set.autoLogin}" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBg}" Icon="avares://BKStudyDesk/Assets/app.ico">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Classes="card-title" Text="{l:T set.autoLogin}" />
        <TextBlock Classes="meta" Text="{l:T autoLogin.noteAnyOs}" />
        <TextBox x:Name="User" PlaceholderText="{l:T autoLogin.user}" />
        <TextBox x:Name="Password" PlaceholderText="{l:T autoLogin.password}" PasswordChar="●" Classes="revealPasswordButton" />
        <TextBlock x:Name="Error" Classes="meta danger" IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="accent" Content="{l:T autoLogin.save}" Click="OnSave" IsDefault="True" />
            <Button Content="{l:T events.cancel}" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
