<!-- Cửa sổ Tải tài liệu LMS nhiều môn (discussion #42): cây học kỳ, lớp, mục; loại file; dải cảnh báo; thanh tiến độ và dòng trạng thái;
     nhật ký tải gập lại. Logic cây, đếm file mới, cảnh báo: BKStudyDesk.Core/Presentation/Download.cs. Đọc, tải: DownloadWindow.axaml.cs. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BKStudyDesk.Desktop.Lang"
        xmlns:p="clr-namespace:SoHocTap.Presentation;assembly=BKStudyDesk.Core"
        x:Class="BKStudyDesk.Desktop.Views.DownloadWindow"
        Title="{l:T download.title}" Width="760" Height="760" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBg}" Icon="avares://BKStudyDesk/Assets/app.ico">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="card-title" Text="{l:T download.title}" />
            <TextBlock x:Name="Sub" Classes="meta" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Classes="meta" Text="{l:T download.kinds}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox x:Name="KindPdf" Content="PDF" IsChecked="True" Click="OnKinds" Margin="0,0,16,0" />
            <CheckBox x:Name="KindSlide" Content="{l:T download.kindSlide}" IsChecked="True" Click="OnKinds" Margin="0,0,16,0" />
            <CheckBox x:Name="KindOther" Content="{l:T download.kindOther}" IsChecked="True" Click="OnKinds" Margin="0,0,16,0" />
            <CheckBox x:Name="Extract" Content="{l:T download.extract}" />
        </WrapPanel>

        <!-- Dưới cùng: nút, nhật ký, trạng thái, cảnh báo (DockPanel xếp từ dưới lên). -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="Start" Classes="accent" Content="{l:T download.start}" Click="OnStart" />
            <Button x:Name="Stop" Content="{l:T download.stop}" Click="OnStop" IsVisible="False" />
            <Button Content="{l:T common.close}" Click="OnClose" />
        </StackPanel>
        <Expander x:Name="LogBox" DockPanel.Dock="Bottom" Header="{l:T download.log}" HorizontalAlignment="Stretch" Margin="0,12,0,0" IsVisible="False">
            <TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="120" />
        </Expander>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <ProgressBar x:Name="Bar" IsVisible="False" />
            <TextBlock x:Name="Status" Classes="meta" TextWrapping="Wrap" />
        </StackPanel>
        <Border x:Name="Notice" DockPanel.Dock="Bottom" Classes="info" Margin="0,12,0,0" IsVisible="False">
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
        </Border>

        <Border Classes="card">
            <Panel>
                <TextBlock x:Name="ListState" Classes="empty" IsVisible="False" />
                <ScrollViewer><ItemsControl x:Name="Terms" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:TermRow">
                            <Expander IsExpanded="{Binding Expanded}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                <Expander.Header>
                                    <CheckBox IsChecked="{Binding Checked, Mode=OneWay}" Click="OnTermCheck">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="name" Text="{Binding Header}" />
                                            <TextBlock Classes="sub" Text="{Binding Meta}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Courses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="p:CourseRow">
                                            <Expander IsExpanded="{Binding Expanded}" Expanding="OnCourseOpen" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                                <Expander.Header>
                                                    <CheckBox IsChecked="{Binding Checked, Mode=OneWay}" Click="OnCourseCheck">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="name" Text="{Binding Name}" />
                                                            <TextBlock Classes="sub" Text="{Binding Meta}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Sections}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="p:SectionRow">
                                                            <CheckBox IsChecked="{Binding Selected}" Click="OnPick" Margin="0,4">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Classes="name" Text="{Binding Name}" />
                                                                    <TextBlock Classes="sub" Text="{Binding Meta}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl></ScrollViewer>
            </Panel>
        </Border>
    </DockPanel>
</Window>
