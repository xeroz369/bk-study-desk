<!-- Trang MyBK: gom mọi mục học vụ của MyBK một chỗ, mỗi mục một tab, mỗi tab một bảng (kiểu bảng chung ở Tokens.axaml).
     Dòng nào hiện, thứ tự, chữ: BKStudyDesk.Core/Presentation/Mybk.cs. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:SoHocTap.Presentation;assembly=BKStudyDesk.Core"
             x:Class="BKStudyDesk.Desktop.Views.MybkView">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Mở MyBK trên web" Click="OnOpenWeb" />
            <StackPanel Spacing="2">
                <TextBlock Classes="title" Text="MyBK" />
                <TextBlock x:Name="Subtitle" Classes="meta" />
                <TextBlock x:Name="StatsText" Classes="meta" />
            </StackPanel>
        </DockPanel>
        <Border Classes="card">
            <TabControl x:Name="Tabs" Padding="0">
                <TabItem Header="Điểm">
                    <DockPanel>
                        <TextBlock x:Name="GradesEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Grades">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="Auto" MinWidth="80" x:DataType="p:MybkGradeRow" />
                                <DataGridTextColumn Header="Môn" Binding="{Binding Name}" Width="2*" MinWidth="180" FontWeight="SemiBold" x:DataType="p:MybkGradeRow" />
                                <DataGridTextColumn Header="Thành phần" Binding="{Binding Parts}" Width="*" MinWidth="140" x:DataType="p:MybkGradeRow" />
                                <DataGridTextColumn Header="TC" Binding="{Binding Credits}" Width="Auto" MinWidth="48" x:DataType="p:MybkGradeRow" />
                                <DataGridTextColumn Header="Điểm" Binding="{Binding Score}" Width="Auto" MinWidth="64" SortMemberPath="SortScore" x:DataType="p:MybkGradeRow" />
                                <DataGridTextColumn Header="Chữ" Binding="{Binding Letter}" Width="Auto" MinWidth="56" x:DataType="p:MybkGradeRow" />
                                <DataGridTemplateColumn Header="Kết quả" Width="Auto" MinWidth="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="p:MybkGradeRow">
                                            <TextBlock Classes.danger="{Binding Fail}" Text="{Binding Result}" VerticalAlignment="Center" Margin="12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Chương trình đào tạo">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="16,8">
                            <ComboBox x:Name="ProgramFilter" SelectionChanged="OnProgramFilter" MinWidth="180" />
                            <TextBlock x:Name="ProgramNote" Classes="meta" />
                        </StackPanel>
                        <TextBlock x:Name="ProgramEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Program">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="Auto" MinWidth="80" x:DataType="p:ProgramRow" />
                                <DataGridTextColumn Header="Môn" Binding="{Binding Name}" Width="*" MinWidth="200" FontWeight="SemiBold" x:DataType="p:ProgramRow" />
                                <DataGridTextColumn Header="TC" Binding="{Binding Credits}" Width="Auto" MinWidth="48" x:DataType="p:ProgramRow" />
                                <DataGridTextColumn Header="Điểm" Binding="{Binding Score}" Width="Auto" MinWidth="64" x:DataType="p:ProgramRow" />
                                <DataGridTextColumn Header="Chữ" Binding="{Binding Letter}" Width="Auto" MinWidth="56" x:DataType="p:ProgramRow" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="Auto" MinWidth="120" x:DataType="p:ProgramRow" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Đăng ký môn">
                    <DockPanel>
                        <TextBlock x:Name="RegisteredEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Registered">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="Auto" MinWidth="80" x:DataType="p:RegisteredRow" />
                                <DataGridTextColumn Header="Môn" Binding="{Binding Name}" Width="*" MinWidth="200" FontWeight="SemiBold" x:DataType="p:RegisteredRow" />
                                <DataGridTextColumn Header="Nhóm lớp" Binding="{Binding ClassGroup}" Width="Auto" MinWidth="96" x:DataType="p:RegisteredRow" />
                                <DataGridTextColumn Header="Đợt" Binding="{Binding Round}" Width="Auto" MinWidth="80" x:DataType="p:RegisteredRow" />
                                <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="Auto" MinWidth="96" x:DataType="p:RegisteredRow" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Giảng viên">
                    <DockPanel>
                        <TextBlock x:Name="TeachersEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Teachers">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Môn" Binding="{Binding Name}" Width="*" MinWidth="180" FontWeight="SemiBold" x:DataType="p:TeacherRow" />
                                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="Auto" MinWidth="80" x:DataType="p:TeacherRow" />
                                <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="Auto" MinWidth="64" x:DataType="p:TeacherRow" />
                                <DataGridTextColumn Header="Thứ" Binding="{Binding Day}" Width="Auto" MinWidth="80" SortMemberPath="DaySort" x:DataType="p:TeacherRow" />
                                <DataGridTextColumn Header="Giờ" Binding="{Binding Time}" Width="Auto" MinWidth="96" x:DataType="p:TeacherRow" />
                                <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="Auto" MinWidth="80" x:DataType="p:TeacherRow" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Học phí">
                    <DockPanel>
                        <TextBlock x:Name="FeesEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Fees">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nội dung" Binding="{Binding Content}" Width="*" MinWidth="200" FontWeight="SemiBold" x:DataType="p:FeeRow" />
                                <DataGridTextColumn Header="Còn nợ" Binding="{Binding Remaining}" Width="Auto" MinWidth="120" SortMemberPath="RemainingValue" x:DataType="p:FeeRow" />
                                <DataGridTextColumn Header="Hạn" Binding="{Binding Due}" Width="Auto" MinWidth="110" x:DataType="p:FeeRow" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Công tác xã hội">
                    <DockPanel>
                        <TextBlock x:Name="SocialTitle" DockPanel.Dock="Top" Classes="meta" Margin="16,8" />
                        <TextBlock x:Name="SocialEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Social">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hoạt động" Binding="{Binding Name}" Width="*" MinWidth="200" FontWeight="SemiBold" x:DataType="p:ActivityRow" />
                                <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="Auto" MinWidth="100" x:DataType="p:ActivityRow" />
                                <DataGridTextColumn Header="Số ngày" Binding="{Binding Days}" Width="Auto" MinWidth="80" x:DataType="p:ActivityRow" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Quyết định">
                    <DockPanel>
                        <TextBlock x:Name="DecisionsEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Decisions">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="Auto" MinWidth="100" x:DataType="p:DecisionRow" />
                                <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="Auto" MinWidth="96" x:DataType="p:DecisionRow" />
                                <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*" MinWidth="200" x:DataType="p:DecisionRow" />
                                <DataGridTextColumn Header="Học kỳ" Binding="{Binding Term}" Width="Auto" MinWidth="96" x:DataType="p:DecisionRow" />
                                <DataGridTextColumn Header="Tình trạng" Binding="{Binding Status}" Width="Auto" MinWidth="96" x:DataType="p:DecisionRow" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Dịch vụ">
                    <DockPanel>
                        <TextBox x:Name="ServiceFilter" DockPanel.Dock="Top" Margin="16,8" PlaceholderText="Lọc dịch vụ theo tên hay nhóm" TextChanged="OnServiceFilter" />
                        <TextBlock x:Name="ServicesEmpty" DockPanel.Dock="Top" Classes="empty" IsVisible="False" />
                        <DataGrid x:Name="Services" DoubleTapped="OnServiceOpen">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding Name}" Width="*" MinWidth="200" FontWeight="SemiBold" x:DataType="p:ServiceRow" />
                                <DataGridTextColumn Header="Hệ thống" Binding="{Binding Site}" Width="Auto" MinWidth="100" x:DataType="p:ServiceRow" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</UserControl>
