<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lõi của BK Study Desk, không phụ thuộc giao diện hay hệ điều hành: config, log, đường dẫn, lưu JSON/secret, xếp file, đồng bộ
    LMS/MyBK, API nội bộ, mô hình dữ liệu, chuỗi ngôn ngữ (lang/), logic từng trang (Presentation/, có test).
    Phần Windows (DPAPI, ACL, tên 8.3, MSIX) có nhánh OperatingSystem.IsWindows(); Linux/macOS có nhánh riêng.
    Namespace giữ SoHocTap.* như bản 1.x (đổi tên chỉ là hình thức, làm diff khó rà).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoHocTap</RootNamespace>
    <AssemblyName>BKStudyDesk.Core</AssemblyName>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Bản đa nền tảng là bản public. -->
    <DefineConstants>$(DefineConstants);PUBLIC_EDITION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\DefaultConfig.json" LogicalName="SoHocTap.Core.DefaultConfig.json" />
    <!-- Khung prompt cho AI (Study Markdown). -->
    <EmbeddedResource Include="Presentation\Practice\Prompts\*.md" LogicalName="Practice.Prompts.%(Filename).md" />
    <None Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppInfo, Startup… là internal trong app WPF; app Avalonia (assembly BKStudyDesk) cũng dùng. -->
    <InternalsVisibleTo Include="BKStudyDesk" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
