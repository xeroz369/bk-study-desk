<!-- Test cho bộ dựng công thức (src/ThirdParty/XamlMath) và MathView: chạy Avalonia headless với Skia để đo glyph thật. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 chạy bằng Microsoft.Testing.Platform (global.json), Avalonia.Headless.XUnit 12 cũng cần v3: project test là Exe. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Giữ 3.x: Avalonia.Headless.XUnit 12.1.x build trên xunit.v3 3.2.2, với 4.x thì lỗi MissingMethodException lúc tìm test (thử 19/10/2026). -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\ThirdParty\XamlMath\AvaloniaMath\AvaloniaMath.csproj" />
    <!-- MathView của app: link file thay vì tham chiếu project app (WinExe, 2 TFM, kéo theo Velopack và WebView). -->
    <Compile Include="..\..\src\BKStudyDesk.Desktop\Views\Practice\MathView.cs" Link="App\MathView.cs" />
    <Compile Include="..\..\src\BKStudyDesk.Desktop\Views\Practice\ContentRenderer.cs" Link="App\ContentRenderer.cs" />
    <!-- Bảng có nhóm của các trang (issue #43): cũng cần Avalonia headless nên ở chung project này. -->
    <Compile Include="..\..\src\BKStudyDesk.Desktop\Views\Tables.cs" Link="App\Tables.cs" />
    <!-- ContentRenderer đọc HTML bằng Html của lõi. -->
    <ProjectReference Include="..\..\src\BKStudyDesk.Core\BKStudyDesk.Core.csproj" />
  </ItemGroup>
</Project>
