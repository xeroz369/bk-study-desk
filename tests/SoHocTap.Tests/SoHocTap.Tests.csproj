<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit test cho phần logic thuần (không WPF, không mạng): tìm thư mục app, chính sách cập nhật, normalizer MyBK, ChangeSet, giờ VN. Link file nguồn từ src\SoHocTap. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Src>..\..\src\SoHocTap\</Src>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="$(Src)Core\AppDirs.cs" Link="Linked\AppDirs.cs" />
    <Compile Include="$(Src)Core\UpdatePolicy.cs" Link="Linked\UpdatePolicy.cs" />
    <Compile Include="$(Src)Updates\DownloadProgress.cs" Link="Linked\DownloadProgress.cs" />
    <Compile Include="$(Src)Core\DataImport.cs" Link="Linked\DataImport.cs" />
    <Compile Include="$(Src)Core\Pace.cs" Link="Linked\Pace.cs" />
    <Compile Include="$(Src)Core\LogRedactor.cs" Link="Linked\LogRedactor.cs" />
    <Compile Include="$(Src)Core\Ics.cs" Link="Linked\Ics.cs" />
    <Compile Include="$(Src)Core\VnTime.cs" Link="Linked\VnTime.cs" />
    <Compile Include="$(Src)Core\SsoLifetime.cs" Link="Linked\SsoLifetime.cs" />
    <Compile Include="$(Src)Ui\NavFit.cs" Link="Linked\NavFit.cs" />
    <Compile Include="$(Src)Ui\ScreenFit.cs" Link="Linked\ScreenFit.cs" />
    <Compile Include="$(Src)Ui\WeekMath.cs" Link="Linked\WeekMath.cs" />
    <Compile Include="$(Src)Ui\FontChoice.cs" Link="Linked\FontChoice.cs" />
    <Compile Include="..\..\src\BKStudyDesk.Setup\InstallTarget.cs" Link="Linked\InstallTarget.cs" />
    <Compile Include="$(Src)Data\Models.cs" Link="Linked\Data\Models.cs" />
    <Compile Include="$(Src)Data\CachedFile.cs" Link="Linked\Data\CachedFile.cs" />
    <Compile Include="$(Src)Data\ChangeSet.cs" Link="Linked\Data\ChangeSet.cs" />
    <Compile Include="$(Src)Data\SyncError.cs" Link="Linked\Data\SyncError.cs" />
    <Compile Include="$(Src)Data\DataDiff.cs" Link="Linked\Data\DataDiff.cs" />
    <Compile Include="$(Src)Data\SyncedFile.cs" Link="Linked\Data\SyncedFile.cs" />
    <Compile Include="$(Src)Core\AtomicFile.cs" Link="Linked\AtomicFile.cs" />
    <Compile Include="$(Src)Shell\Reminders.cs" Link="Linked\Reminders.cs" />
    <Compile Include="$(Src)Data\CustomEvents.cs" Link="Linked\Data\CustomEvents.cs" />
    <Compile Include="$(Src)Data\QuickEntry.cs" Link="Linked\Data\QuickEntry.cs" />
    <Compile Include="$(Src)Sources\ISource.cs" Link="Linked\Sources\ISource.cs" />
    <Compile Include="$(Src)Sources\SyncProgress.cs" Link="Linked\Sources\SyncProgress.cs" />
    <Compile Include="$(Src)Ui\ProgressGate.cs" Link="Linked\ProgressGate.cs" />
    <Compile Include="$(Src)Sources\SyncErrors.cs" Link="Linked\Sources\SyncErrors.cs" />
    <Compile Include="$(Src)Sources\Lms\LmsException.cs" Link="Linked\Sources\LmsException.cs" />
    <Compile Include="$(Src)Sources\Lms\AssignPairing.cs" Link="Linked\Sources\AssignPairing.cs" />
    <Compile Include="$(Src)Sources\Lms\GroupFilter.cs" Link="Linked\Sources\GroupFilter.cs" />
    <Compile Include="$(Src)Sources\Mybk\MybkNormalize.cs" Link="Linked\Sources\MybkNormalize.cs" />
    <!-- Phần Files không phụ thuộc config: test trên thư mục tạm. Không link Paths/Config: Paths.AppRoot đi ngược từ thư mục test
         lên tới thư mục có data\, trong worktree dưới "Sổ học tập" đó là data thật của người dùng. -->
    <Compile Include="$(Src)Files\FileOps.cs" Link="Linked\Files\FileOps.cs" />
    <Compile Include="$(Src)Files\JunkFilter.cs" Link="Linked\Files\JunkFilter.cs" />
    <Compile Include="$(Src)Files\NameMatch.cs" Link="Linked\Files\NameMatch.cs" />
    <Compile Include="$(Src)Files\LmsPlacement.cs" Link="Linked\Files\LmsPlacement.cs" />
    <Compile Include="$(Src)Files\DocumentScan.cs" Link="Linked\Files\DocumentScan.cs" />
    <!-- Thư viện: adapter /v1 và ghép môn không phụ thuộc Config/Paths; test với HttpMessageHandler giả, không gọi mạng. -->
    <Compile Include="$(Src)Library\LibraryContract.cs" Link="Linked\Library\LibraryContract.cs" />
    <Compile Include="$(Src)Library\LibraryClient.cs" Link="Linked\Library\LibraryClient.cs" />
    <Compile Include="$(Src)Library\LibraryMatch.cs" Link="Linked\Library\LibraryMatch.cs" />
    <Compile Include="$(Src)Library\QuizPackHandOff.cs" Link="Linked\Library\QuizPackHandOff.cs" />
    <Compile Include="$(Src)Library\LibraryActions.cs" Link="Linked\Library\LibraryActions.cs" />
    <Compile Include="$(Src)Api\PackImport.cs" Link="Linked\Api\PackImport.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- File ngôn ngữ (test parity) và fixture viết tay (không có dữ liệu thật) chép ra thư mục output. -->
    <None Include="$(Src)lang\*.json" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- XAML của các Window (test: window nào cũng theo phông, cỡ chữ đã chọn). -->
    <None Include="$(Src)Ui\*Window.xaml" Link="xaml\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
