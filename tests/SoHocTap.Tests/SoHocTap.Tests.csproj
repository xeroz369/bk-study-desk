<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit test cho phần logic thuần (không WPF, không mạng): tìm thư mục app, chính sách cập nhật, normalizer MyBK, ChangeSet, giờ VN. Link file nguồn từ src\SoHocTap. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Src>..\..\src\SoHocTap\</Src>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="$(Src)Core\AppDirs.cs" Link="Linked\AppDirs.cs" />
    <Compile Include="$(Src)Core\UpdatePolicy.cs" Link="Linked\UpdatePolicy.cs" />
    <Compile Include="$(Src)Core\DataImport.cs" Link="Linked\DataImport.cs" />
    <Compile Include="$(Src)Core\Pace.cs" Link="Linked\Pace.cs" />
    <Compile Include="$(Src)Core\LogRedactor.cs" Link="Linked\LogRedactor.cs" />
    <Compile Include="$(Src)Core\Ics.cs" Link="Linked\Ics.cs" />
    <Compile Include="$(Src)Core\VnTime.cs" Link="Linked\VnTime.cs" />
    <Compile Include="$(Src)Ui\NavFit.cs" Link="Linked\NavFit.cs" />
    <Compile Include="$(Src)Ui\ScreenFit.cs" Link="Linked\ScreenFit.cs" />
    <Compile Include="..\..\src\BKStudyDesk.Setup\InstallTarget.cs" Link="Linked\InstallTarget.cs" />
    <Compile Include="$(Src)Data\Models.cs" Link="Linked\Data\Models.cs" />
    <Compile Include="$(Src)Data\CachedFile.cs" Link="Linked\Data\CachedFile.cs" />
    <Compile Include="$(Src)Data\ChangeSet.cs" Link="Linked\Data\ChangeSet.cs" />
    <Compile Include="$(Src)Data\SyncError.cs" Link="Linked\Data\SyncError.cs" />
    <Compile Include="$(Src)Sources\ISource.cs" Link="Linked\Sources\ISource.cs" />
    <Compile Include="$(Src)Sources\SyncErrors.cs" Link="Linked\Sources\SyncErrors.cs" />
    <Compile Include="$(Src)Sources\Lms\LmsException.cs" Link="Linked\Sources\LmsException.cs" />
    <Compile Include="$(Src)Sources\Lms\AssignPairing.cs" Link="Linked\Sources\AssignPairing.cs" />
    <Compile Include="$(Src)Sources\Mybk\MybkNormalize.cs" Link="Linked\Sources\MybkNormalize.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- File ngôn ngữ (test parity) và fixture viết tay (không có dữ liệu thật) chép ra thư mục output. -->
    <None Include="$(Src)lang\*.json" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
